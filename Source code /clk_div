timescale 1ns / 1ps
module clk_div #(
    parameter integer DIV = 10
)(
    input  wire clk_in,
    input  wire rst,
    output reg  clk_out
);
    reg [31:0] count;
    always @(posedge clk_in or posedge rst)
    begin
        if (rst) 
        begin
            count   <= 0;
            clk_out <= 1'b0;
        end
        else if (count == DIV - 1) 
        begin
            count   <= 0;
            clk_out <= ~clk_out;
        end
        else begin
            count <= count + 1'b1;
        end
    end
